# Environment Configuration Template for Niti Detective Game
# Copy this file to .env and fill in your actual values

# Hugging Face API Token
# Required for downloading private/gated models like FLUX.1-dev
# Get your token from: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# Optional: Custom model repository
# HF_MODEL_REPO=black-forest-labs/FLUX.1-dev

# Optional: Cache directory for models
# HF_CACHE_DIR=/models

# Optional: Disable telemetry
# HF_HUB_DISABLE_TELEMETRY=1